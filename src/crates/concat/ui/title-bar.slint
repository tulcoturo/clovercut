import { I18n } from "i18n.slint";
import { Theme } from "theme/theme.slint";
import { Glyph, Icon } from "icons.slint";
import { AddPaneButton, PaneKind } from "workspace/pane-switcher.slint";
import { Tip } from "primitives/tooltip.slint";
import { Editor } from "editor.slint";

// The custom title bar.
//
// On macOS the native traffic lights are overlaid: platform.rs hides the real
// title bar (titlebar_transparent + title_hidden + fullsize_content_view) and
// this strip leaves room for the lights on the left. Everywhere else the
// platform's decorations are gone altogether and the strip draws its own
// minimise, maximise and close at the right, in that order, the way every
// window on those platforms has them. Everything that is not a control is a
// drag region — the TouchArea at the bottom of the tree starts a native
// window drag on press, and controls declared after it take their own
// presses.

// One of the strip's window buttons. Caption-button proportions rather than
// the 24px icon buttons beside Settings: wider than tall, flush with the top
// and right edges of the window, no rounding - a target you can throw the
// pointer at the corner to hit. Close hovers red, as it does everywhere.
component WindowButton inherits Rectangle {
    in property <Glyph> glyph;
    in property <bool> danger;

    callback clicked();

    width: 46px;
    background: touch.has-hover
        ? (root.danger ? Theme.danger : Theme.field)
        : Colors.transparent;

    animate background { duration: 100ms; easing: cubic-bezier(0.4, 0, 0.2, 1); }

    Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        glyph: root.glyph;
        size: 12px;
        weight: 1.6;
        tint: touch.has-hover
            ? (root.danger ? Theme.on-scrim : Theme.fg)
            : Theme.fg-muted;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component MenuLabel inherits Rectangle {
    in property <string> label;
    /// this label's menu is the one currently open
    in property <bool> current;

    callback clicked();

    width: text.preferred-width + 16px;
    border-radius: Theme.r-sm;
    background: (root.current || touch.has-hover) ? Theme.field : Colors.transparent;

    animate background { duration: 100ms; easing: cubic-bezier(0.4, 0, 0.2, 1); }

    text := Text {
        x: 8px;
        y: (parent.height - self.height) / 2;
        text: root.label;
        color: (root.current || touch.has-hover) ? Theme.fg : Theme.fg-muted;
        font-size: Theme.fs;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component HeaderIconButton inherits Rectangle {
    in property <Glyph> glyph;
    in property <string> tip: "";

    callback clicked();

    width: 24px;
    height: 24px;
    border-radius: Theme.r-sm;
    background: touch.has-hover ? Theme.field : Colors.transparent;

    animate background { duration: 100ms; easing: cubic-bezier(0.4, 0, 0.2, 1); }

    Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        glyph: root.glyph;
        size: 14px;
        tint: touch.has-hover ? Theme.fg : Theme.fg-muted;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    if root.tip != "": Tip {
        text: root.tip;
        active: touch.has-hover;
    }
}

component LayoutMenuItem inherits Rectangle {
    in property <string> text;
    in property <bool> checked: false;
    callback clicked();

    height: 28px;
    border-radius: Theme.r-sm;
    background: touch.has-hover ? Theme.field : Colors.transparent;

    animate background { duration: 80ms; }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        alignment: start;

        Rectangle {
            width: 14px;
            height: 14px;
            y: (parent.height - self.height) / 2;
            if root.checked: Icon {
                x: 0;
                y: 0;
                width: 14px;
                height: 14px;
                glyph: Glyph.check;
                size: 13px;
                weight: 2.0;
                tint: Theme.accent;
            }
        }

        Text {
            text: root.text;
            color: root.checked ? Theme.accent : Theme.fg;
            font-size: Theme.fs;
            font-weight: root.checked ? Theme.weight-title : 400;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component LayoutSwitcherButton inherits Rectangle {
    property <length> menu-w: 210px;
    property <length> menu-h: 7 * 28px + 17px;

    width: 24px;
    height: 24px;
    border-radius: Theme.r-sm;
    background: touch.has-hover ? Theme.field : Colors.transparent;

    animate background { duration: 100ms; easing: cubic-bezier(0.4, 0, 0.2, 1); }

    Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        glyph: Glyph.slot;
        size: 14px;
        tint: touch.has-hover ? Theme.fg : Theme.fg-muted;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { menu.show(); }
    }

    Tip {
        text: I18n.t("layout.switcher");
        active: touch.has-hover;
    }

    menu := PopupWindow {
        x: root.width - root.menu-w;
        y: root.height + 4px;
        width: root.menu-w;
        height: root.menu-h;
        close-policy: close-on-click-outside;

        Rectangle {
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.line-strong;
            border-radius: Theme.r;
            drop-shadow-blur: 12px;
            drop-shadow-color: Colors.black.with-alpha(0.35);
            drop-shadow-offset-y: 4px;
            clip: true;

            VerticalLayout {
                padding: 4px;
                spacing: 1px;

                LayoutMenuItem {
                    text: I18n.t("layout.default");
                    checked: Editor.active-layout-preset == 0;
                    clicked => {
                        menu.close();
                        Editor.select-layout-preset(0);
                    }
                }
                LayoutMenuItem {
                    text: I18n.t("layout.audio");
                    checked: Editor.active-layout-preset == 1;
                    clicked => {
                        menu.close();
                        Editor.select-layout-preset(1);
                    }
                }
                LayoutMenuItem {
                    text: I18n.t("layout.verticalRight");
                    checked: Editor.active-layout-preset == 2;
                    clicked => {
                        menu.close();
                        Editor.select-layout-preset(2);
                    }
                }
                LayoutMenuItem {
                    text: I18n.t("layout.verticalLeft");
                    checked: Editor.active-layout-preset == 3;
                    clicked => {
                        menu.close();
                        Editor.select-layout-preset(3);
                    }
                }
                LayoutMenuItem {
                    text: I18n.t("layout.inspectorPriority");
                    checked: Editor.active-layout-preset == 4;
                    clicked => {
                        menu.close();
                        Editor.select-layout-preset(4);
                    }
                }
                LayoutMenuItem {
                    text: I18n.t("layout.mediaPriority");
                    checked: Editor.active-layout-preset == 5;
                    clicked => {
                        menu.close();
                        Editor.select-layout-preset(5);
                    }
                }

                // Divider
                Rectangle {
                    height: 1px;
                    background: Theme.line;
                }

                LayoutMenuItem {
                    text: I18n.t("layout.resetCurrent");
                    checked: false;
                    clicked => {
                        menu.close();
                        Editor.reset-current-layout();
                    }
                }
            }
        }
    }
}

export component TitleBar inherits Rectangle {
    in property <string> project-name: I18n.t("common.untitledProject");
    /// "saved", "saving…" — the little truth beside the name. Empty hides it.
    in property <string> status: I18n.t("common.saved");
    /// Leaves room for the traffic lights and drops nothing else; on other
    /// platforms the strip starts at the left edge.
    in property <bool> macos: true;
    /// The launch screen's face: the theme toggle and the window buttons,
    /// and nothing else. The menus act on a project, the panel picker and
    /// Export act on an edit, and on this screen there is neither — a strip
    /// of controls that all refuse is worse than a strip without them.
    in property <bool> minimal;
    /// The launch screen is under the strip, which has a ground of its own —
    /// a deeper one than the editor's. The strip takes that ground rather
    /// than its usual panel, so the launcher reads as one room and not as a
    /// dark window with a light lid. See the `launch-` ladder in theme/.
    in property <bool> deep;

    /// Draw the window buttons at the right: true wherever the platform's
    /// decorations were taken off, which is everywhere but macOS.
    in property <bool> own-buttons;
    /// The window is maximised, so the middle button restores rather than
    /// maximises and shows the two-squares glyph.
    in property <bool> maximized;

    callback renamed(name: string);
    property <bool> editing-name;
    property <string> draft-name;
    callback begin-drag();
    callback toggle-maximize();
    callback minimize();
    callback close();
    /// A menu was asked for: which one, and where its label sits in the strip,
    /// so the sheet can hang off it.
    callback menu-opened(index: int, at-x: length, keyboard: bool);
    /// Which menu is open, or -1.
    in property <int> menu: -1;
    /// A menu asked for from the keyboard (F10, Alt+F/E/V, the arrows in
    /// an open one): `keyboard-menu` is which, and a change of
    /// `keyboard-token` is the asking. The label opens itself, since only
    /// it knows where it is.
    in property <int> keyboard-menu: -1;
    in property <int> keyboard-token;
    callback open-settings();
    /// A view was picked from the add-panel list.
    callback add-pane(kind: PaneKind);
    callback export-clicked();

    height: 32px;
    // The window's ground, not a panel's: the strip is the frame the panes
    // float in, and it reads as one with the gutters between them.
    background: root.deep ? Theme.launch-page : Theme.page;

    property <bool> drag-armed: false;
    property <length> press-x: 0px;
    property <length> press-y: 0px;

    // Whatever is not a control drags the window. Declared first so every
    // control sits above it and takes its own presses; Texts and plain
    // Rectangles are not hit targets, so presses on them fall through here.
    drag := TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down
                && event.button == PointerEventButton.left) {
                root.drag-armed = true;
                root.press-x = self.mouse-x;
                root.press-y = self.mouse-y;
            } else if (event.kind == PointerEventKind.up
                || event.kind == PointerEventKind.cancel) {
                root.drag-armed = false;
            }
        }
        moved => {
            if (root.drag-armed && self.pressed) {
                if (Math.abs(self.mouse-x - root.press-x) > 4px
                    || Math.abs(self.mouse-y - root.press-y) > 4px) {
                    root.drag-armed = false;
                    root.begin-drag();
                }
            }
        }
        double-clicked => {
            root.drag-armed = false;
            root.toggle-maximize();
        }
    }

    HorizontalLayout {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        padding-left: root.macos ? 80px : 8px;
        // No right padding when the strip ends in its own buttons: the close
        // button belongs in the corner, not eight pixels shy of it.
        padding-right: root.own-buttons ? 0px : 8px;
        spacing: 2px;

        // CapCut-style Brand Mark: App Icon + Typography Wordmark
        VerticalLayout {
            alignment: center;
            padding-right: 12px;

            HorizontalLayout {
                spacing: 8px;
                alignment: center;

                VerticalLayout {
                    alignment: center;
                    Image {
                        source: @image-url("../../../../assets/applogo.svg");
                        width: 22px;
                        height: 22px;
                        image-fit: contain;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    Image {
                        source: @image-url("../../../../assets/typography.svg");
                        height: 19px;
                        width: 90px;
                        image-fit: contain;
                    }
                }
            }
        }

        // Each label reports its own position rather than a fixed one: they
        // are sized from their text, so where "View" starts depends on how
        // long "File" and "Edit" are.
        if !root.minimal: file := MenuLabel {
            label: I18n.t("titleBar.file");
            current: root.menu == 0;
            clicked => {
                root.menu-opened(0, file.absolute-position.x - root.absolute-position.x, false);
            }
            property <int> asked: root.keyboard-token;
            changed asked => {
                if (root.keyboard-menu == 0) {
                    root.menu-opened(0, file.absolute-position.x - root.absolute-position.x, true);
                }
            }
        }
        if !root.minimal: edit := MenuLabel {
            label: I18n.t("titleBar.edit");
            current: root.menu == 1;
            clicked => {
                root.menu-opened(1, edit.absolute-position.x - root.absolute-position.x, false);
            }
            property <int> asked: root.keyboard-token;
            changed asked => {
                if (root.keyboard-menu == 1) {
                    root.menu-opened(1, edit.absolute-position.x - root.absolute-position.x, true);
                }
            }
        }
        if !root.minimal: view := MenuLabel {
            label: I18n.t("titleBar.view");
            current: root.menu == 2;
            clicked => {
                root.menu-opened(2, view.absolute-position.x - root.absolute-position.x, false);
            }
            property <int> asked: root.keyboard-token;
            changed asked => {
                if (root.keyboard-menu == 2) {
                    root.menu-opened(2, view.absolute-position.x - root.absolute-position.x, true);
                }
            }
        }

        Rectangle { horizontal-stretch: 1; }

        // CapCut-style top-right header actions:
        // Layout Switcher | Keyboard Shortcuts | Settings | Export
        if !root.minimal: VerticalLayout {
            alignment: center;
            LayoutSwitcherButton {}
        }

        if !root.minimal: VerticalLayout {
            alignment: center;
            HeaderIconButton {
                glyph: Glyph.keyboard;
                tip: I18n.t("settings.shortcuts");
                clicked => { Editor.open-shortcuts(); }
            }
        }

        VerticalLayout {
            alignment: center;
            HeaderIconButton {
                glyph: Glyph.settings;
                tip: I18n.t("common.settings");
                clicked => { root.open-settings(); }
            }
        }

        if !root.minimal: VerticalLayout {
            alignment: center;
            padding-left: 4px;

            export-button := Rectangle {
                width: label.width + icon.width + 28px;
                height: 26px;
                border-radius: Theme.r-sm;
                background: export-touch.has-hover ? Theme.accent-hover : Theme.accent;

                animate background { duration: 100ms; easing: cubic-bezier(0.4, 0, 0.2, 1); }

                icon := Icon {
                    x: 10px;
                    y: (parent.height - self.height) / 2;
                    glyph: Glyph.export;
                    size: 13px;
                    weight: 2.0;
                    tint: Theme.on-accent;
                }

                label := Text {
                    x: icon.x + icon.width + 6px;
                    y: (parent.height - self.height) / 2;
                    text: I18n.t("common.export");
                    color: Theme.on-accent;
                    font-size: Theme.fs;
                    font-weight: Theme.weight-title;
                }

                export-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.export-clicked(); }
                }
            }
        }

        // The window's own buttons, last so they sit flush against the right
        // edge. Full height of the strip, no vertical centring: a caption
        // button's target is the whole strip height, corner included.
        if root.own-buttons: Rectangle { width: 6px; }
        if root.own-buttons: HorizontalLayout {
            spacing: 0px;
            WindowButton {
                glyph: Glyph.minus;
                clicked => { root.minimize(); }
            }
            WindowButton {
                glyph: root.maximized ? Glyph.copy : Glyph.maximize;
                clicked => { root.toggle-maximize(); }
            }
            WindowButton {
                glyph: Glyph.close;
                danger: true;
                clicked => { root.close(); }
            }
        }
    }

    // Centre: the project name and status pill, placed against the whole strip rather than
    // laid out, so it stays centred in the window and not in whatever space
    // the menus leave over.
    centre := HorizontalLayout {
        visible: !root.minimal;
        x: (parent.width - self.preferred-width) / 2;
        y: 0;
        width: self.preferred-width;
        height: parent.height;
        spacing: 8px;

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 220px;
                height: 24px;
                if !root.editing-name: Text {
                    text: root.project-name;
                    color: Theme.fg;
                    font-size: Theme.fs;
                    font-weight: Theme.weight-title;
                    overflow: elide;
                    vertical-alignment: center;
                }
                if !root.editing-name: TouchArea {
                    mouse-cursor: text;
                    clicked => {
                        root.draft-name = root.project-name;
                        root.editing-name = true;
                        name-input.focus();
                    }
                }
                name-input := TextInput {
                    visible: root.editing-name;
                    text <=> root.draft-name;
                    color: Theme.fg;
                    font-size: Theme.fs;
                    single-line: true;
                    vertical-alignment: center;
                    changed has-focus => {
                        if !self.has-focus { root.editing-name = false; }
                    }
                    accepted => {
                        root.editing-name = false;
                        root.renamed(root.draft-name);
                    }
                    key-pressed(event) => {
                        if event.text == Key.Escape {
                            root.editing-name = false;
                            return accept;
                        }
                        return reject;
                    }
                }
            }
        }

        if root.status != "": VerticalLayout {
            alignment: center;
            Rectangle {
                height: 18px;
                width: status-txt.preferred-width + 12px;
                border-radius: Theme.r-sm;
                background: Theme.field;

                status-txt := Text {
                    x: 6px;
                    y: (parent.height - self.height) / 2;
                    text: root.status;
                    font-size: Theme.fs-xs;
                    color: Theme.fg-muted;
                }
            }
        }
    }
}
