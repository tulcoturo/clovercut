# Maintainer: 9M2PJU <https://github.com/9M2PJU>
# Upstream: https://github.com/tulcoturo/clovercut
# AUR package: clovercut-bin (prebuilt AppImage from GitHub releases).
# To update for a new release: bump pkgver, replace both sha256sums with the
# matching lines from the release's SHA256SUMS file, regenerate .SRCINFO with
# `makepkg --printsrcinfo > .SRCINFO`, then push this directory to AUR.
pkgname=clovercut-bin
pkgver=0.2.1
pkgrel=1
pkgdesc="Desktop-first, open-source video editor with built-in stock libraries and local AI"
arch=('x86_64' 'aarch64')
url="https://github.com/tulcoturo/clovercut"
license=('AGPL-3.0-or-later')
depends=('glibc' 'hicolor-icon-theme' 'gtk3' 'fontconfig' 'freetype2' 'libxkbcommon' 'libxkbcommon-x11' 'mesa' 'libglvnd' 'alsa-lib')
options=('!strip' '!debug')
provides=('clovercut')
conflicts=('clovercut')
source_x86_64=("Clovercut-${pkgver}-x86_64.AppImage::https://github.com/tulcoturo/clovercut/releases/download/v${pkgver}/Clovercut-${pkgver}-x86_64.AppImage")
source_aarch64=("Clovercut-${pkgver}-aarch64.AppImage::https://github.com/tulcoturo/clovercut/releases/download/v${pkgver}/Clovercut-${pkgver}-aarch64.AppImage")
sha256sums_x86_64=('7f6af190e3c5835e9774b119aea6eab9e0f873e87511c692c22cc543c58e37a1')
sha256sums_aarch64=('795e10e4b0d0cfd4137b28618a29bd33e9dc837f23c4da025e7590a005953932')

prepare() {
  local appimage="${srcdir}/Clovercut-${pkgver}-${CARCH}.AppImage"
  chmod +x "$appimage"
  cd "$srcdir"
  "$appimage" --appimage-extract >/dev/null
  test -x squashfs-root/AppRun
  test -f squashfs-root/io.github.tulcoturo.clovercut.desktop
  test -f squashfs-root/clovercut.png
}

package() {
  install -d "$pkgdir/opt/clovercut" "$pkgdir/usr/bin"
  cp -a "$srcdir/squashfs-root/." "$pkgdir/opt/clovercut/"
  printf '#!/bin/sh\nexec /opt/clovercut/AppRun "$@"\n' > "$pkgdir/usr/bin/clovercut"
  chmod 755 "$pkgdir/usr/bin/clovercut"
  install -Dm644 "$srcdir/squashfs-root/io.github.tulcoturo.clovercut.desktop" \
    "$pkgdir/usr/share/applications/io.github.tulcoturo.clovercut.desktop"
  install -Dm644 "$srcdir/squashfs-root/clovercut.png" \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/clovercut.png"
  install -Dm644 "$srcdir/squashfs-root/usr/share/doc/clovercut/LICENSE" \
    "$pkgdir/usr/share/licenses/clovercut-bin/LICENSE"
  install -Dm644 "$srcdir/squashfs-root/usr/share/doc/clovercut/THIRD_PARTY_NOTICES.md" \
    "$pkgdir/usr/share/doc/clovercut-bin/THIRD_PARTY_NOTICES.md"
}
