import { SpeedPanel } from "__SPEED_PANEL__";
export { SpeedRamp, SpeedPointData } from "__SPEED_GRAPH__";
export component SpeedProbe inherits Window {
    width: 640px;
    height: 800px;
    in-out property <int> commits;
    VerticalLayout {
        SpeedPanel { commit => { root.commits += 1; } }
    }
}
