import "__FONTS__/HankenGrotesk-Regular.ttf";
import "__FONTS__/HankenGrotesk-Medium.ttf";
import "__FONTS__/HankenGrotesk-SemiBold.ttf";
import "__FONTS__/HankenGrotesk-Bold.ttf";
import "__FONTS__/HankenGrotesk-Italic.ttf";

export { Theme } from "__THEME__";

import { StartScreen, RecentProjectData, NewProjectDialog } from "__START_SCREEN__";
import { DirectWheelFlickable } from "__SCROLLBAR__";
export component HomeProbe inherits Window {
    in property <length> probe-width: 1100px;
    in property <length> probe-height: 900px;
    width: root.probe-width;
    height: root.probe-height;
    in-out property <string> query: "Project";
    in-out property <bool> busy;
    in-out property <int> view;
    in-out property <int> sort;
    in-out property <int> opens;
    in-out property <int> reveals;
    in-out property <int> forgets;
    in property <[RecentProjectData]> projects;
    in property <bool> project-test;
    in property <bool> custom-project;
    in property <bool> creating-project;
    in-out property <int> aspect;
    in-out property <int> creates;
    in property <bool> wheel-test;
    out property <length> wheel-offset: wheel.content-y;
    wheel := DirectWheelFlickable {
        visible: root.wheel-test;
        x: 0px;
        y: 0px;
        accessible-role: list;
        accessible-label: "wheel-test";
        width: 200px;
        height: 200px;
        content-width: 200px;
        content-height: 1000px;
        Rectangle { width: 200px; height: 1000px; background: blue; }
    }
    if !root.wheel-test && !root.project-test: StartScreen {
        width: parent.width;
        height: parent.height;
        recents: root.projects;
        recents-total: root.projects.length;
        query: root.query;
        busy: root.busy;
        view: root.view;
        sort: root.sort;
        sort-changed(sort) => { root.sort = sort; }
        version: "QA";
        search-edited(query) => { root.query = query; }
        view-changed(view) => { root.view = view; }
        open-recent(path) => { root.opens += 1; }
        reveal-recent(path) => { root.reveals += 1; }
        forget-recent(path) => { root.forgets += 1; }
    }
    if root.project-test: NewProjectDialog {
        width: parent.width;
        height: parent.height;
        data: {composing: true, name: "A project", location: "/synthetic",
            aspect: root.aspect, frame-aspect: 16 / 9,
            size: root.custom-project ? 4 : 1,
            custom-width: 1920, custom-height: 1080, custom-fps: 29.97,
            size-readout: "1920 × 1080", rate-readout: "30000/1001 fps",
            rate-options: ["24 fps", "30 fps", "Custom"], rate: 1,
            busy: root.creating-project,
            error: root.custom-project ? "A long creation error that wraps onto several lines on a small window and must not hide the Create button or make it unreachable." : ""};
        aspects: [
            {label: "16:9", ratio: 16 / 9}, {label: "9:16", ratio: 9 / 16},
            {label: "1:1", ratio: 1}, {label: "4:3", ratio: 4 / 3},
            {label: "4:5", ratio: 4 / 5}, {label: "3:4", ratio: 3 / 4},
        ];
        sizes: [{label: "720p"}, {label: "1080p"}, {label: "2K"}, {label: "4K"}];
        aspect-changed(index) => { root.aspect = index; }
        create => { root.creates += 1; }
    }

}
