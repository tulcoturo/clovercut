import { CatalogueCard, CatalogueItemData } from "__MEDIA_PANE__";
export { TransitionPreview } from "__TRANSITION_PREVIEW__";
export { Glyph } from "__PRIMITIVES__";
export component EffectsProbe inherits Window {
    width: 320px;
    height: 240px;
    in property <CatalogueItemData> item;
    in-out property <int> applied;
    CatalogueCard {
        x: 20px;
        y: 20px;
        width: 160px;
        height: 190px;
        item: root.item;
        glyph: root.item.glyph;
        applied => { root.applied += 1; }
    }
}

import { MediaPane } from "__MEDIA_PANE__";
import { CatalogueEntryData } from "__INSPECTOR__";
export component SubjectShelfProbe inherits Window {
    width: 900px;
    height: 600px;
    in property <[CatalogueEntryData]> entries;
    in-out property <int> clip-applied;
    in-out property <int> layer-applied;
    MediaPane {
        catalogue-effects: root.entries;
        apply-effect(id) => { root.clip-applied += 1; }
        apply-filter(id, label) => { root.layer-applied += 1; }
    }
}
